{"type":"group","name":"yoda's harvesting system","enabled":false,"items":[{"type":"function","name":"onLoad","enabled":true,"code":"/*\n * Yoda's Harvesting System\n * Display installation confirmation and instructions.\n */\n\nset_variable(\"harvest_auto\", 0);\nset_variable(\"harvest_install_test\", \"executed\");\ndisplay_notice(\"========================================\");\ndisplay_notice(\"     Yoda's Harvesting System v2.0\");\ndisplay_notice(\"========================================\");\ndisplay_notice(\"Yoda's Harvesting System loaded successfully!\");\ndisplay_notice(\"\");\ndisplay_notice(\"Commands:\");\ndisplay_notice(\"  hv    - Harvest the current room.\");\ndisplay_notice(\"  hvon  - Enable automatic harvesting.\");\ndisplay_notice(\"  hvoff - Disable automatic harvesting.\");\ndisplay_notice(\"\");\ndisplay_notice(\"Thank you for using Yoda's Harvesting System!\");\ndisplay_notice(\"Created by Master Yoda Darrion, Ancient Acolyte.\");\ndisplay_notice(\"========================================\");"},{"type":"function","name":"onUninstall","enabled":true,"code":"/*\n * Yoda's Harvesting System\n * Display package removal confirmation.\n */\n\ndisplay_notice(\"========================================\");\ndisplay_notice(\"     Yoda's Harvesting System v2.0\");\ndisplay_notice(\"========================================\");\ndisplay_notice(\"Package uninstalled.\");\ndisplay_notice(\"\");\ndisplay_notice(\"Thank you for giving this system a try!\");\ndisplay_notice(\"May your harvests always be plentiful.\");\ndisplay_notice(\"\");\ndisplay_notice(\"Created by Master Yoda Darrion, Ancient Acolyte.\");\ndisplay_notice(\"========================================\");"},{"type":"alias","name":"Harvest Room","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Initialize and request plants.\n */\n\nset_variable(\"harvest_queue\", \"[]\");\nset_variable(\"harvest_active\", 0);\nset_variable(\"harvest_current\", \"\");\nset_variable(\"harvest_waiting\", 0);\n\n// Indicate that we are collecting a plant list.\nset_variable(\"harvest_scanning\", 1);\nset_variable(\"harvest_list_started\", 0);\n\ndisplay_notice(\"Scanning for harvestable plants...\");\n\nsend_command(\"PLANTS\");"}],"text":"hv","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Harvest - Identify Plants","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Identify and queue harvestable plants.\n */\n\nconst plants = new Set([\n  \"ginseng\", \"ash\", \"echinacea\", \"ginger\",\n  \"burdock\", \"myrrh\", \"bellwort\", \"bloodroot\",\n  \"hawthorn\", \"kuzu\", \"skullcap\", \"slipper\",\n  \"goldenseal\", \"valerian\", \"bayberry\", \"cohosh\",\n  \"lobelia\", \"pear\", \"weed\", \"irid\",\n  \"sileris\", \"kelp\", \"kola\", \"elm\"\n]);\n\nconst line = current_text();\nconst match = line.match(/\\(([a-z]+)\\)\\s+\\S+\\s*$/i);\n\nif (match) {\n  const plant = match[1].toLowerCase();\n\n  if (plants.has(plant)) {\n    let queue = get_variable(\"harvest_queue\") || \"[]\";\n\n    // Convert stored JSON into a JavaScript array.\n    if (typeof queue === \"string\") {\n      try {\n        queue = JSON.parse(queue);\n      } catch (error) {\n        display_notice(\"Harvest queue error: \" + error.message);\n        queue = [];\n      }\n    }\n\n    if (!Array.isArray(queue)) {\n      queue = [];\n    }\n\n    // Prevent duplicate plant entries.\n    if (!queue.includes(plant)) {\n      queue.push(plant);\n\n      // Store the queue as a JSON string.\n      set_variable(\"harvest_queue\", JSON.stringify(queue));\n\n      display_notice(\"Queued for harvest: \" + plant);\n    }\n  }\n}"}],"text":"^.*\\(([a-z]+)\\)\\s+\\S+\\s*$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harvest - Plant List Started","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Mark the beginning of the plant list.\n */\n\nif (Number(get_variable(\"harvest_scanning\")) === 1) {\n  set_variable(\"harvest_list_started\", 1);\n}"}],"text":"The following plants are growing in this room:","matching":"exact","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harvest - Scan Complete","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Begin harvesting when the PLANTS response ends.\n */\n\nif (\n  Number(get_variable(\"harvest_scanning\")) === 1 &&\n  Number(get_variable(\"harvest_list_started\")) === 1\n) {\n\n  // The plant list has finished arriving.\n  set_variable(\"harvest_scanning\", 0);\n  set_variable(\"harvest_list_started\", 0);\n\n  let queue = get_variable(\"harvest_queue\") || \"[]\";\n\n  if (typeof queue === \"string\") {\n    try {\n      queue = JSON.parse(queue);\n    } catch (error) {\n      display_notice(\"Queue error: \" + error.message);\n      queue = [];\n    }\n  }\n\n  if (!Array.isArray(queue)) {\n    queue = [];\n  }\n\n  if (queue.length > 0) {\n\n    const plant = queue.shift();\n\n    set_variable(\"harvest_queue\", JSON.stringify(queue));\n    set_variable(\"harvest_current\", plant);\n    set_variable(\"harvest_active\", 1);\n    set_variable(\"harvest_waiting\", 0);\n\n    display_notice(\"Harvesting: \" + plant);\n\n    send_command(\"QUEUE ADD B HARVEST \" + plant);\n\n  } else {\n    display_notice(\"No harvestable plants found.\");\n  }\n}"}],"text":"^\\d+h,\\s*\\d+m\\s+\\S+$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harvest - Successful Harvest","enabled":true,"actions":[{"type":"command","enabled":true,"command":"INR ALL","prefix_suffix":false},{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Handle successful harvest and await balance.\n */\n\nif (Number(get_variable(\"harvest_active\")) === 1) {\n\n  const plant = get_variable(\"harvest_current\");\n\n  display_notice(\"Harvest successful: \" + plant);\n\n  // The harvest consumed physical balance.\n  // Wait for balance to return before continuing.\n  set_variable(\"harvest_waiting\", 1);\n}"}],"text":"You reach out and carefully harvest","matching":"substring","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harvest - Unavailable Plant","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Handle an unavailable plant.\n */\n\nif (Number(get_variable(\"harvest_active\")) === 1) {\n\n  const plant = get_variable(\"harvest_current\");\n\n  display_notice(\"Already harvested: \" + plant);\n\n  // The failed harvest did not consume balance.\n  set_variable(\"harvest_active\", 0);\n  set_variable(\"harvest_current\", \"\");\n  set_variable(\"harvest_waiting\", 0);\n\n  // Read the remaining harvest queue.\n  let queue = get_variable(\"harvest_queue\") || \"[]\";\n\n  if (typeof queue === \"string\") {\n    try {\n      queue = JSON.parse(queue);\n    } catch (error) {\n      display_notice(\"Queue error: \" + error.message);\n      queue = [];\n    }\n  }\n\n  if (!Array.isArray(queue)) {\n    queue = [];\n  }\n\n  if (queue.length > 0) {\n\n    // Select the next plant.\n    const nextPlant = queue.shift();\n\n    set_variable(\"harvest_queue\", JSON.stringify(queue));\n    set_variable(\"harvest_current\", nextPlant);\n    set_variable(\"harvest_active\", 1);\n\n    display_notice(\"Harvesting: \" + nextPlant);\n\n    // Queue one harvest command.\n    send_command(\"QUEUE ADD B HARVEST \" + nextPlant);\n\n  } else {\n    display_notice(\"Harvest queue complete.\");\n  }\n}"}],"text":"^(You have already harvested from this plant recently\\.|That plant has been fully harvested\\.|You don't have the skill to harvest from that plant yet\\.)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harvest - Balance Recovered","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Continue after balance recovery.\n */\n\nif (\n  Number(get_variable(\"harvest_active\")) === 1 &&\n  Number(get_variable(\"harvest_waiting\")) === 1\n) {\n\n  // Verify that Nexus reports physical balance.\n  if (Number(get_variable(\"my_bal\")) === 1) {\n\n    set_variable(\"harvest_active\", 0);\n    set_variable(\"harvest_waiting\", 0);\n    set_variable(\"harvest_current\", \"\");\n\n    let queue = get_variable(\"harvest_queue\") || \"[]\";\n\n    if (typeof queue === \"string\") {\n      try {\n        queue = JSON.parse(queue);\n      } catch (error) {\n        display_notice(\"Queue error: \" + error.message);\n        queue = [];\n      }\n    }\n\n    if (!Array.isArray(queue)) {\n      queue = [];\n    }\n\n    if (queue.length > 0) {\n\n      const nextPlant = queue.shift();\n\n      set_variable(\"harvest_queue\", JSON.stringify(queue));\n      set_variable(\"harvest_current\", nextPlant);\n      set_variable(\"harvest_active\", 1);\n\n      display_notice(\"Harvesting: \" + nextPlant);\n\n      send_command(\"QUEUE ADD B HARVEST \" + nextPlant);\n\n    } else {\n      display_notice(\"Harvest queue complete.\");\n    }\n  }\n}"}],"text":"You have recovered balance on all limbs.","matching":"exact","whole_words":true,"case_sensitive":true},{"type":"alias","name":"Harvest - Automatic On","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Enable automatic harvesting.\n */\n\nset_variable(\"harvest_auto\", 1);\n\ndisplay_notice(\"Automatic harvesting ENABLED.\");"}],"text":"hvon","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Harvest - Automatic Off","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/*\n * Yoda's Harvesting System\n * Disable automatic harvesting.\n */\n\nset_variable(\"harvest_auto\", 0);\n\ndisplay_notice(\"Automatic harvesting DISABLED.\");"}],"text":"hvoff","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"event","name":"","enabled":true,"actions":[{"type":"script","enabled":true,"script":"/* global arguments */\n\n/*\n * Yoda's Harvesting System\n * Automatically harvest upon entering a new room.\n */\n\nconst eventData = arguments[0];\nconst roomId = Array.isArray(eventData)\n  ? eventData[0]\n  : eventData;\n\nconst previousId = get_variable(\"harvest_last_room\");\n\n// Ignore room refreshes that do not change location.\nif (roomId !== undefined && roomId !== null) {\n\n  const newRoom = String(roomId) !== String(previousId);\n\n  // Always track location, even when auto-harvesting is off.\n  set_variable(\"harvest_last_room\", String(roomId));\n\n  if (\n    newRoom &&\n    Number(get_variable(\"harvest_auto\")) === 1 &&\n    Number(get_variable(\"harvest_active\")) === 0 &&\n    Number(get_variable(\"harvest_scanning\")) === 0\n  ) {\n\n    // Initialize the harvesting system.\n    set_variable(\"harvest_queue\", \"[]\");\n    set_variable(\"harvest_active\", 0);\n    set_variable(\"harvest_current\", \"\");\n    set_variable(\"harvest_waiting\", 0);\n    set_variable(\"harvest_scanning\", 1);\n    set_variable(\"harvest_list_started\", 0);\n\n    display_notice(\"Auto-harvest: Scanning new room.\");\n\n    send_command(\"PLANTS\");\n  }\n}"}],"evtype":"GMCP","evsubtype":"Room.Info"},{"type":"function","name":"onUnload","enabled":true,"code":"/*\n * Yoda's Harvesting System\n * Test package unload event.\n */\n\ndisplay_notice(\"~~~ Yoda's Harvesting System Unloaded ~~~\");"}],"description":"An automated harvesting system for Achaea's Nexus client. Identifies harvestable plants, queues collection according to physical balance, skips previously harvested plants, and automatically stores collected herbs in the Rift. Toggle with hvon and hvoff. Activates on movement when enabled."}